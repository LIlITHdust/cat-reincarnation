{
  "name": "cat-reincarnation",
  "version": "1.0.0",
  "description": "cat reincarnation — an AI cat's eight acts, generated in code with Remotion",
  "repository": {},
  "license": "MIT",
  "private": false,
  "keywords": [
    "remotion",
    "music-video",
    "generative",
    "canvas",
    "typescript"
  ],
  "dependencies": {
    "@remotion/cli": "4.0.535",
    "@remotion/effects": "4.0.535",
    "@remotion/fonts": "4.0.535",
    "@remotion/google-fonts": "4.0.535",
    "@remotion/media": "4.0.535",
    "@remotion/transitions": "4.0.535",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.535"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.535",
    "@types/react": "19.2.7",
    "@types/web": "0.0.166",
    "eslint": "9.39.5",
    "prettier": "3.8.1",
    "typescript": "5.9.3"
  },
  "scripts": {
    "dev": "remotion studio",
    "build": "remotion bundle",
    "upgrade": "remotion upgrade",
    "lint": "eslint src && tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "render": "remotion render CatReincarnation out/cat-reincarnation.mp4",
    "render:4k": "remotion render CatReincarnation out/cat-reincarnation-4k.mp4 --scale=2",
    "stills": "remotion still CatReincarnation out/still.jpg --frame=4020"
  }
}
